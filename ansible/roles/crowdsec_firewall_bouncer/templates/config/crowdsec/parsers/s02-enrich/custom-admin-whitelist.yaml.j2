name: custom/admin-whitelist
description: "Admin and trusted IP addresses - NEVER block these"
filter: "1 == 1"
whitelist:
  reason: "Admin/trusted IP - DO NOT BLOCK"
  ip:
    - "{{ crowdsec_config.admin_ip }}"
    - "{{ crowdsec_config.admin_secondary_ip }}"
  cidr:
    - "10.100.0.0/16" # Pangolin tunnel network
    - "172.16.0.0/12" # Docker internal networks
    - "{{ crowdsec_config.admin_isp_cidr }}"
